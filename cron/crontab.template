# Ride Optimizer - Smart Static Architecture Cron Jobs
# Replace PROJECT_PATH with actual path to project root
# Replace CONTAINER_NAME with the running podman container name
#
# Jobs run inside the app container via `podman exec` instead of with the
# host's own Python. data/ and config/ are bind-mounted into the container
# and owned by its rootless-Podman subuid, not the host cron user — running
# the scripts on bare host Python caused near-constant PermissionError
# failures on every job (#543). `podman exec` runs as the container's
# default user (rideopt), which already owns those files.

# Daily analysis at 2 AM
0 2 * * * cd PROJECT_PATH && podman exec CONTAINER_NAME python cron/daily_analysis.py >> logs/cron.log 2>&1

# Weather refresh every 6 hours
0 */6 * * * cd PROJECT_PATH && podman exec CONTAINER_NAME python cron/weather_refresh.py >> logs/cron.log 2>&1

# Cache cleanup daily at 3 AM
0 3 * * * cd PROJECT_PATH && podman exec CONTAINER_NAME python cron/cache_cleanup.py >> logs/cron.log 2>&1

# System health check every other hour
0 */2 * * * cd PROJECT_PATH && podman exec CONTAINER_NAME python cron/system_health.py >> logs/cron.log 2>&1

# Log rotation weekly on Sunday at 4 AM
0 4 * * 0 cd PROJECT_PATH && find logs/ -name "*.log" -mtime +7 -exec gzip {} \; && find logs/ -name "*.gz" -mtime +30 -delete
